{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#2C3E50", "name": "Primary — REPLACE with actual brand color" },
				{ "slug": "secondary", "color": "#E67E22", "name": "Secondary — REPLACE with actual brand color" },
				{ "slug": "background", "color": "#FFFFFF", "name": "Background" },
				{ "slug": "foreground", "color": "#1A1A1A", "name": "Foreground / body text" },
				{ "slug": "contrast", "color": "#F5F5F5", "name": "Light contrast / section background" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
					"slug": "body",
					"name": "Body — REPLACE with actual body font"
				},
				{
					"fontFamily": "\"Quattrocento\", Georgia, serif",
					"slug": "nav",
					"name": "Quattrocento (confirmed current nav font)"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "medium", "size": "1rem", "name": "Medium" },
				{ "slug": "large", "size": "1.5rem", "name": "Large" },
				{ "slug": "x-large", "size": "2.25rem", "name": "Extra Large" }
			]
		},
		"spacing": {
			"spacingScale": { "steps": 7 },
			"units": ["px", "em", "rem", "%", "vh", "vw"]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--nav)"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
